{
  "name": "@fabric/rpg",
  "version": "0.1.0-RC1",
  "description": "Fabric 0.1.0 playnet game service. Local RPG state, signed contract messages, optional HTTP gateway.",
  "engines": {
    "node": "26.12.1"
  },
  "main": "types/rpg.js",
  "exports": {
    ".": "./types/rpg.js",
    "./constants": "./constants.js",
    "./constants.js": "./constants.js",
    "./functions/*.js": "./functions/*.js",
    "./functions/*": "./functions/*.js",
    "./inputs/*": "./inputs/*",
    "./services/*.js": "./services/*.js",
    "./services/*": "./services/*.js",
    "./types/*.js": "./types/*.js",
    "./types/*": "./types/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "agents": "node scripts/agents.js",
    "build:scripts": "webpack",
    "build:ui": "cd components/semantic && gulp build && cp dist/semantic.js ../../assets/scripts/semantic.js && cp dist/semantic.css ../../assets/styles/semantic.css && cd ../..",
    "build": "npm run compile",
    "compile": "node scripts/build.js #&& npm run build:scripts",
    "coverage": "c8 npm test",
    "dev": "webpack serve --static assets",
    "docs": "npm run build && jsdoc -c jsdoc.json types README.md -d docs && http-server docs -p 8000",
    "make:coverage": "npm run coverage && c8 report --reporter html",
    "report:coverage": "npm run make:coverage && c8 report --reporter=text-lcov > reports/coverage.lcov",
    "report:install": "rm -rf node_modules && mkdir -p reports && rm -f package-lock.json && echo \"$ npm i --allow-git=all\" > reports/install.log && npm i --allow-git=all >> reports/install.log 2>&1",
    "review:coverage": "npm run make:coverage && http-server reports/code-coverage -p 8000",
    "start": "npm run compile && node scripts/node.js",
    "static": "npm run build && http-server assets -p 8000",
    "test": "mocha tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabricLabs/rpg.git"
  },
  "keywords": [
    "bitcoin",
    "fabric",
    "game",
    "rpg"
  ],
  "author": "Fabric Labs",
  "contributors": [
    "Alexey Melnichenko",
    "Eric Martindale"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FabricLabs/rpg/issues"
  },
  "homepage": "https://github.com/FabricLabs/rpg#readme",
  "dependencies": {
    "@fabric/core": "FabricLabs/fabric#feature/locks",
    "@fabric/http": "FabricLabs/fabric-http#feature/fomantic"
  },
  "devDependencies": {
    "buffer": "=6.0.3",
    "c8": "=12.0.0",
    "http-server": "=14.1.1",
    "jsdoc": "=4.0.5",
    "mocha": "=12.0.3",
    "path-browserify": "=1.0.1",
    "pixel-editor": "=0.2.0",
    "process": "=0.11.10",
    "querystring-es3": "=0.2.1",
    "stream-browserify": "=3.0.0",
    "webpack": "=5.112.2",
    "webpack-cli": "=5.1.4",
    "webpack-dev-server": "=6.1.0"
  },
  "c8": {
    "include": [
      "components/*.js",
      "functions/*.js",
      "types/*.js"
    ],
    "exclude": [
      "tests"
    ],
    "report-dir": "./reports/code-coverage"
  }
}
